# Variables de entorno - copiar a .env y completar
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hidroponia
JWT_SECRET=supersecreto_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# MQTT - Broker (ej. Mosquitto). La placa Arduino UNO WiFi Rev2 publica aquí
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=hidroponia/#

# CORS
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
